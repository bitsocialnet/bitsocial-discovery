# bitsocial-discovery configuration.
# All settings are plain environment variables; the server does not read .env
# files itself. See README.md for what each source does.

# ── HTTP API ─────────────────────────────────────────────────────────────────
# Loopback by default: the list contains communities nobody has reviewed.
#PORT=4100
#HOST=127.0.0.1
#ALLOWED_ORIGINS=*

# ── storage ──────────────────────────────────────────────────────────────────
#DB_PATH=./data/discovery.db

# ── the node communities are fetched through ─────────────────────────────────
# Use a fetch-only node (README, "Fetch-only node"): discovery fetches
# communities nobody has reviewed, and a normal node serves what it fetched.
#PKC_RPC_URL=ws://localhost:9138

# ── where discovery starts (all empty = idle) ────────────────────────────────
#SEEDS=memes.bso,12D3KooW...
#SEEDS_SOURCES=https://raw.githubusercontent.com/bitsocialnet/lists/master/seedit-default-subscriptions.json
#SUBMISSIONS_SOURCE=./submissions.json
#INDEXER_URLS=https://api.seeditarchive.org,https://api.5archive.org
# Needs eth_getLogs over all contracts with a topic filter and ranges of
# thousands of blocks; many free endpoints refuse that (README, "ENS").
#ETH_RPC_URL=https://rpc.mevblocker.io
#ENS_FROM_BLOCK=23085558
#ENS_MAX_BLOCK_RANGE=50000
#SOURCES_REFRESH_MS=3600000

# ── checking candidates ──────────────────────────────────────────────────────
#CHECK_CONCURRENCY=2
#CHECK_TIMEOUT_MS=120000
#RECHECK_INTERVAL_MS=21600000
#RETRY_MIN_MS=900000
#RETRY_MAX_MS=604800000
#AUTHOR_CHAIN_DEPTH=3
#MAX_CHAINS_PER_CHECK=50

# ── what the API shows ───────────────────────────────────────────────────────
#OVERRIDES_SOURCE=./overrides.json
# all = every resolved community not hidden/blocked; reviewed = approved + listed only
#PUBLIC_LISTING=all
#ADMIN_TOKEN=
