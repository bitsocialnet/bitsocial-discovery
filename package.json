{
  "name": "@bitsocial/discovery",
  "version": "0.1.0",
  "private": true,
  "description": "Finds Bitsocial communities that no list has carried: author chains, crossposts, mentions, ENS records",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/",
    "start": "node dist/index.js",
    "test": "DB_PATH=:memory: node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@pkcprotocol/pkc-js": "0.0.125",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "viem": "^2.57.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "node-forge": "1.4.1",
    "protobufjs": "7.6.6"
  }
}
